# Local mode: fictional demo accounts and sample records.
SEED_DEMO=true
DATA_DIR=data
BUSINESS_TIMEZONE=Asia/Tehran
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Optional PostgreSQL overrides (one isolated DB/account per service):
# PERSONNEL_DATABASE_URL=postgresql+psycopg://personnel:password@localhost:5432/personnel
# INVENTORY_DATABASE_URL=postgresql+psycopg://inventory:password@localhost:5432/inventory
# COMMERCE_DATABASE_URL=postgresql+psycopg://commerce:password@localhost:5432/commerce
# For an EMPTY server database: set SEED_DEMO=false, ADMIN_USERNAME and a unique ADMIN_PASSWORD (12+ characters).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# No secrets should be placed in NEXT_PUBLIC_ variables.
