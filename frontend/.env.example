# The launcher sets the system; each application has its own API and session.
# Override this with your public HTTPS API URL when deploying online.
# NEXT_PUBLIC_API_URL=https://personnel-api.example.com/api/v1
# NEXT_PUBLIC_SYSTEM=personnel
# API_BASE is read at runtime in production; use a public URL accessible by the browser.
# API_BASE=https://personnel-api.example.com/api/v1
# API_URL is an equivalent runtime alias, used by compose.yaml.
# API_URL=https://personnel-api.example.com/api/v1
# NEXT_PUBLIC_PERSONNEL_URL=https://personnel.example.com
# NEXT_PUBLIC_INVENTORY_URL=https://inventory.example.com
# NEXT_PUBLIC_COMMERCE_URL=https://commerce.example.com
